# Ambiente
.venv/
__pycache__/
*.pyc
# metadati generati da `pip install -e .`
*.egg-info/
.env
.pytest_cache/
# config locale di Obsidian (per-macchina) e settings locali di Claude
.obsidian/
.claude/settings.local.json

# Dati locali (DB + risultati grezzi): rigenerabili, non versionati.
data/kb.sqlite3
data/raw/
data/*.log

# Dati personali sensibili: solo locali, mai nella cronologia Git pubblica.
data/private/

# Profili personali (PII): non versionati. Solo l'esempio di riferimento resta tracciato.
profiles/*.yaml
!profiles/example_athlete.yaml

# La wiki/ è INTENZIONALMENTE versionata: è l'output della knowledge base.
