# Copiare in `.env`. Tutte le variabili sono opzionali: senza chiave LLM la
# pipeline usa euristiche deterministiche offline.

# Contatto per la "polite pool" delle API (NCBI/OpenAlex/Crossref).
KB_CONTACT_EMAIL=you@example.com

# Chiave LLM (Anthropic). Se assente → modalità euristica offline.
# Accetta anche la variabile standard ANTHROPIC_API_KEY.
KB_ANTHROPIC_API_KEY=
KB_LLM_MODEL=claude-opus-4-8

# Forza le euristiche anche con chiave presente (utile per demo riproducibili).
KB_FORCE_OFFLINE=0

# Chiave NCBI opzionale (aumenta il rate limit di E-utilities).
KB_NCBI_API_KEY=

# Parametri di recupero.
KB_RESULTS_PER_SOURCE=25
KB_CITATION_CHASE_SEEDS=5
KB_CITATION_CHASE_LIMIT=15

# Versionamento Git della wiki.
KB_GIT_AUTOCOMMIT=1
